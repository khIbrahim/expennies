{% extends 'layout.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('profile') }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('profile') }}
{% endblock %}

{% block title %}My Profile{% endblock %}

{% block content %}
    <div class="profile container content-body py-5">
        <div class="card shadow-lg border-0 rounded-4 animate__animated animate__fadeIn">
            <div class="card-body p-5">
                <div class="d-flex align-items-center mb-4">
                    <div>
                        <h1 class="h3 mb-1">Welcome Back, {{ profile.name }}!</h1>
                        <p class="text-muted mb-0">Manage your account settings and preferences</p>
                    </div>
                </div>

                <form class="needs-validation" id="profile-form" novalidate>
                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="form-floating">
                                <input type="email"
                                       class="form-control bg-light"
                                       id="email"
                                       name="email"
                                       value="{{ profile.email }}"
                                       disabled>
                                <label for="email">Email Address</label>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-floating">
                                <input type="text"
                                       class="form-control"
                                       id="name"
                                       name="name"
                                       value="{{ profile.name }}"
                                       required>
                                <label for="name">Full Name</label>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-floating">
                                <input type="tel"
                                       class="form-control"
                                       id="phone"
                                       name="phone"
                                       value="{{ profile.phone|default('') }}"
                                       pattern="[0-9]{10}"
                                       placeholder="Phone Number">
                                <label for="phone">Phone Number (Optional)</label>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="card bg-light border-0 rounded-3">
                                <div class="card-body">
                                    <h5 class="card-title mb-3">Security Settings</h5>
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div>
                                            <h6 class="mb-1">Two-Factor Authentication</h6>
                                            <p class="text-muted small mb-0">Add an extra layer of security to your account</p>
                                        </div>
                                        <div class="form-check form-switch" >
                                            <input type="hidden" name="twoFactor" value="0">
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   id="twoFactor"
                                                   value="1"
                                                   name="twoFactor"
                                                    {{ profile.twoFactor ? 'checked' : '' }}
                                                   style="transform: scale(1.5)"
                                                   style="cursor: pointer">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-3 justify-content-center mt-5">
                        <button type="button"
                                class="btn btn-outline-primary px-4 py-2"
                                data-bs-toggle="modal"
                                data-bs-target="#updatePasswordModal">
                            <i class="bi bi-shield-lock-fill me-2"></i>
                            Change Password
                        </button>
                        <button type="submit"
                                class="btn btn-primary px-4 py-2 save-profile">
                            <i class="bi bi-check2-circle me-2" id="saveChangesIcon"></i>
                            <div class="spinner-border spinner-border-sm" role="status" id="loadingSpinner" style="display: none;">
                                <span class="visually-hidden"> Saving...</span>
                            </div>
                            Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    {% include 'profile/update_password_modal.twig' %}
{% endblock %}