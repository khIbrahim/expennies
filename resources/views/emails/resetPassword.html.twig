<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Your Password</title>
</head>
<body>
<div class="container">
    <div class="card mt-5">
        <div class="card-header bg-primary text-white text-center">
            <h1 class="card-title">Reset Your Password</h1>
        </div>
        <div class="card-body">
            <p class="card-text">Hello,</p>
            <p class="card-text">We received a request to reset your password for your Expennies account. Click the button below to update your password:</p>

            <!-- Bouton de réinitialisation -->
            <div class="d-grid gap-2 col-6 mx-auto">
                <a href="{{ activationLink }}" class="btn btn-primary btn-lg" target="_blank">Reset Password</a>
            </div>

            <p class="card-text mt-3">If you didn't request this, you can safely ignore this email. The link will expire on <strong>{{ expirationDate | date('d/m/Y g:i A') }}</strong>.</p>
            <p class="card-text">Thank you,</p>
            <p class="card-text">The Expennies Team</p>
        </div>
        <div class="card-footer text-muted text-center">
            <p>If you're having trouble with the button above, copy and paste the following link into your browser:</p>
            <p><a href="{{ activationLink }}" target="_blank">{{ activationLink }}</a></p>
        </div>
    </div>
</div>
</body>
</html>